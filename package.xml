<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>concrete_block_assembly_planning</name>
  <version>0.0.0</version>
  <description>
    Assembly/task planning layer for the concrete-block stack: expands compact
    wall specs into per-block plans, validates reachability/collision, sequences
    them (support-graph topo-sort), and serves the next pick-and-place task to
    the behavior tree. Owns wall plans and the interactive wall origin.
  </description>
  <maintainer email="gerald.ebmer.fl@ait.ac.at">vscode</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>concrete_block_assembly_interfaces</depend>
  <depend>concrete_block_world_model_interfaces</depend>

  <exec_depend>rviz2</exec_depend>
  <exec_depend>timber_crane_planning_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
